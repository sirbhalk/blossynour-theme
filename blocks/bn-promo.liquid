{% doc %}
  Blossy Nour promo line, tagline and "what's inside" checklist for the product info column.
{% enddoc %}
<div class="bn-pblock" {{ block.shopify_attributes }}>
  {%- if block.settings.promo != blank -%}<p class="bn-pblock__promo">{% if block.settings.promo_icon != 'none' %}{% render 'bn-icon', name: block.settings.promo_icon, class: 'bn-inline-icon' %}{% endif %}<span>{{ block.settings.promo }}</span></p>{%- endif -%}
  {%- if block.settings.tagline != blank -%}<p class="bn-pblock__tagline">{% if block.settings.tagline_icon != 'none' %}{% render 'bn-icon', name: block.settings.tagline_icon, class: 'bn-inline-icon' %}{% endif %}<span>{{ block.settings.tagline }}</span></p>{%- endif -%}
  {%- if block.settings.tagline_ar != blank -%}<span class="bn-ar" lang="ar">{{ block.settings.tagline_ar }}</span>{%- endif -%}
  {%- if block.settings.checklist != blank -%}
    {%- assign lines = block.settings.checklist | newline_to_br | split: '<br />' -%}
    <ul class="bn-check" role="list">
      {%- for line in lines -%}
        {%- assign l = line | strip -%}
        {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

