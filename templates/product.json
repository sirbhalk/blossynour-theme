      "blocks": {
        "bn_p_faq_1": {
          "type": "question",
          "settings": {
            "question": "C'est quoi exactement ?",
            "answer": "<p>Un rituel bien-être à la maison, inspiré du hammam : de l'eau chaude, un sachet de plantes séchées et un siège pour vous installer 10 à 15 minutes. C'est un moment de détente, pas un traitement.</p>"
          }
        },
        "bn_p_faq_2": {
          "type": "question",
          "settings": {
            "question": "À quelle fréquence l'utiliser ?",
            "answer": "<p>Une à deux fois par semaine, quand vous avez envie d'un moment pour vous. Écoutez votre corps.</p>"
          }
        },
        "bn_p_faq_3": {
          "type": "question",
          "settings": {
            "question": "Est-ce que ça se boit ?",
            "answer": "<p>Non. Les plantes sont uniquement pour la vapeur. Ne pas boire, ne pas manger.</p>"
          }
        },
        "bn_p_faq_4": {
          "type": "question",
          "settings": {
            "question": "Je peux l'utiliser pendant mes règles ou si je suis enceinte ?",
            "answer": "<p>Non. Pas pendant les règles, la grossesse, l'allaitement, ni après un accouchement ou une opération sans l'avis de votre médecin.</p>"
          }
        },
        "bn_p_faq_5": {
          "type": "question",
          "settings": {
            "question": "J'ai une odeur inhabituelle ou des pertes, ça va m'aider ?",
            "answer": "<p>Ce produit ne soigne rien. Une odeur inhabituelle, des pertes, une démangeaison ou une douleur doivent être vues par un médecin ou une sage-femme.</p>"
          }
        },
        "bn_p_faq_6": {
          "type": "question",
          "settings": {
            "question": "Comment je paie ?",
            "answer": "<p>À la livraison, en espèces. Vous pouvez vérifier le colis devant le livreur. Si un article arrive abîmé, on le remplace.</p>"
          }
        },
        "bn_p_faq_7": {
          "type": "question",
          "settings": {
            "question": "Le colis est-il discret ?",
            "answer": "<p>Oui. Le carton extérieur ne porte aucun nom de produit.</p>"
          }
        },
        "bn_p_faq_8": {
          "type": "question",
          "settings": {
            "question": "Combien de temps pour la livraison ?",
            "answer": "<p>Le délai dépend de votre ville. Nous vous appelons ou vous écrivons sur WhatsApp pour confirmer la commande avant l'envoi.</p>"
          }
        }
      },
