    "bn_p_faq": {
      "type": "bn-faq",
      "blocks": {
        "bn_p_faq_1": {
          "type": "question",
          "settings": {
            "question": "What is it exactly?",
            "answer": "<p>An at-home wellness ritual inspired by the hammam: hot water, a sachet of dried herbs and a seat to sit on for 10 to 15 minutes. It's a moment of relaxation, not a treatment.</p>"
          }
        },
        "bn_p_faq_2": {
          "type": "question",
          "settings": {
            "question": "How often should I use it?",
            "answer": "<p>Once or twice a week, whenever you want a moment for yourself. Listen to your body.</p>"
          }
        },
        "bn_p_faq_3": {
          "type": "question",
          "settings": {
            "question": "Can I drink it?",
            "answer": "<p>No. The herbs are for steaming only. Do not drink or eat them.</p>"
          }
        },
        "bn_p_faq_4": {
          "type": "question",
          "settings": {
            "question": "Can I use it during my period or if I'm pregnant?",
            "answer": "<p>No. Not during your period, pregnancy or breastfeeding, nor after giving birth or surgery without your doctor's advice.</p>"
          }
        },
        "bn_p_faq_5": {
          "type": "question",
          "settings": {
            "question": "I have an unusual odor or discharge. Will it help?",
            "answer": "<p>This product does not treat anything. An unusual odor, discharge, itching or pain should be checked by a doctor or midwife.</p>"
          }
        },
        "bn_p_faq_6": {
          "type": "question",
          "settings": {
            "question": "How do I pay?",
            "answer": "<p>In cash, on delivery. You can check the parcel in front of the courier. If an item arrives damaged, we replace it.</p>"
          }
        },
        "bn_p_faq_7": {
          "type": "question",
          "settings": {
            "question": "Is the parcel discreet?",
            "answer": "<p>Yes. The outer box shows no product name.</p>"
          }
        },
        "bn_p_faq_8": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>It depends on your city. We call you or message you on WhatsApp to confirm your order before shipping.</p>"
          }
        }
      },
