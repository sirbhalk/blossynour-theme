{%- if section.blocks.size > 0 -%}
<div class="bn-ann" style="--bn-ann-bg: {{ section.settings.background }}; --bn-ann-fg: {{ section.settings.text_color }};">
  <ul class="bn-ann__list" role="list" data-bn-ann>
    {%- for block in section.blocks -%}
      <li class="bn-ann__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}{% render 'bn-icon', name: block.settings.icon, class: 'bn-ann__icon' %}{%- endif -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}<span>{{ block.settings.text }}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- if section.blocks.size > 1 -%}
<script>
  (function () {
    var list = document.querySelector('[data-bn-ann]');
    if (!list || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var items = list.children, i = 0;
    setInterval(function () {
      if (window.innerWidth >= 990) return;
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    }, 3500);
  })();
</script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "BN · Announcement bar",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#4A2A3A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FBF5EE" }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
        { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "cash", "label": "Cash" },
        { "value": "box", "label": "Box" }, { "value": "rose", "label": "Rose" }, { "value": "leaf", "label": "Leaf" },
        { "value": "shield", "label": "Shield" }, { "value": "heart", "label": "Heart" }, { "value": "sparkle", "label": "Sparkle" }
      ] },
      { "type": "text", "id": "text", "label": "Text", "default": "Livraison gratuite sur le pack complet" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "BN · Announcement bar" } ]
}
{% endschema %}
