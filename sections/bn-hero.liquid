{%- liquid
  assign has_bg = false
  if section.settings.background_image != blank
    assign has_bg = true
  endif
-%}
<section class="bn-section bn-hero{% unless has_bg %} bn-hero--no-image bn-section--pattern{% endunless %}" id="bn-hero-{{ section.id }}">
  {%- if has_bg -%}
    <div class="bn-hero__media">
      {{ section.settings.background_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', alt: section.settings.background_image.alt }}
    </div>
  {%- endif -%}
  <div class="bn-hero__inner">
    <div class="bn-hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="bn-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="bn-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.heading_ar != blank -%}<span class="bn-ar" lang="ar">{{ section.settings.heading_ar }}</span>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="bn-lead">{{ section.settings.text }}</div>{%- endif -%}
      <div class="bn-hero__ctas">
        {%- if section.settings.button_label != blank -%}
          <a class="bn-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="bn-btn bn-btn--ghost" href="{{ section.settings.button2_link | default: '#bn-steps' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="bn-hero__chips" role="list">
          {%- for block in section.blocks -%}
            <li class="bn-chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- unless has_bg -%}
      <div class="bn-hero__arch">
        <div class="bn-hero__arch-inner">
          {%- if section.settings.arch_image != blank -%}
            {{ section.settings.arch_image | image_url: width: 900 | image_tag: loading: 'eager', sizes: '(min-width: 750px) 380px, 78vw', alt: section.settings.arch_image.alt }}
          {%- else -%}
            {% render 'bn-icon', name: 'arch-rose' %}
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "BN · Hero",
  "class": "bn-shopify-section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Full-width background image (optional)" },
    { "type": "image_picker", "id": "arch_image", "label": "Image inside the arch", "info": "Used when there is no background image. Portrait photo works best." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Rituel de vapeur aux plantes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Votre petit hammam, chez vous" },
    { "type": "text", "id": "heading_ar", "label": "Arabic / Darija line", "default": "حمام صغير فدارك" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>15 minutes de chaleur douce et de parfums de rose, rien que pour vous. Un rituel bien-être inspiré du hammam marocain.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Commencer mon rituel" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Comment ça marche" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "blocks": [
    { "type": "chip", "name": "Chip", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Paiement à la livraison" } ] }
  ],
  "presets": [
    {
      "name": "BN · Hero",
      "blocks": [
        { "type": "chip", "settings": { "text": "🌹 Plantes marocaines" } },
        { "type": "chip", "settings": { "text": "💵 Paiement à la livraison" } },
        { "type": "chip", "settings": { "text": "📦 Emballage discret" } }
      ]
    }
  ]
}
{% endschema %}
