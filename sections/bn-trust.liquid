<section class="bn-section bn-trust bn-section--{{ section.settings.style }}">
  <ul class="bn-trust__grid" role="list" style="--bn-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
    {%- for block in section.blocks -%}
      <li class="bn-trust__item" {{ block.shopify_attributes }}>
        {% render 'bn-icon', name: block.settings.icon, class: 'bn-trust__icon' %}
        <span class="bn-trust__label">
          {{- block.settings.title -}}
          {%- if block.settings.subtitle != blank -%}<span class="bn-trust__sub">{{ block.settings.subtitle }}</span>{%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "BN · Trust row",
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "default": "white", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "blush", "label": "Blush" }, { "value": "white", "label": "White" }, { "value": "plum", "label": "Plum" }
    ] }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "rose", "label": "Rose" }, { "value": "steam", "label": "Steam" },
        { "value": "truck", "label": "Truck" }, { "value": "cash", "label": "Cash" }, { "value": "box", "label": "Box" },
        { "value": "shield", "label": "Shield" }, { "value": "heart", "label": "Heart" }, { "value": "clock", "label": "Clock" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Plantes marocaines" },
      { "type": "text", "id": "subtitle", "label": "Subtitle" }
    ] }
  ],
  "presets": [
    {
      "name": "BN · Trust row",
      "blocks": [
        { "type": "item", "settings": { "icon": "rose", "title": "Plantes séchées", "subtitle": "Rose, lavande, camomille" } },
        { "type": "item", "settings": { "icon": "cash", "title": "Paiement à la livraison", "subtitle": "Partout au Maroc" } },
        { "type": "item", "settings": { "icon": "box", "title": "Emballage discret", "subtitle": "Aucun nom sur le colis" } },
        { "type": "item", "settings": { "icon": "shield", "title": "Remplacé si abîmé", "subtitle": "Vérifiez à la livraison" } }
      ]
    }
  ]
}
{% endschema %}
