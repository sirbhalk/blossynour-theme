{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="bn-section bn-reviews bn-section--{{ section.settings.style }}">
  <div class="bn-container">
    <div class="bn-center">
      {%- if section.settings.eyebrow != blank -%}<p class="bn-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="bn-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.heading_ar != blank -%}<span class="bn-ar" lang="ar">{{ section.settings.heading_ar }}</span>{%- endif -%}
      <div class="bn-divider"><span></span></div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="bn-reviews__track" role="list">
        {%- for block in section.blocks -%}
          <li class="bn-review" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Message de cliente' }}
            {%- endif -%}
            <span class="bn-review__stars" aria-label="{{ block.settings.rating }} sur 5">{% for i in (1..block.settings.rating) %}★{% endfor %}</span>
            <p class="bn-review__text">{{ block.settings.text }}</p>
            <p class="bn-review__who">{{ block.settings.name }}{% if block.settings.city != blank %} <span>· {{ block.settings.city }}</span>{% endif %}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="bn-editor-note">Visible uniquement dans l'éditeur : ajoutez ici les vrais avis de vos clientes (avec leur accord). La section reste cachée sur le site tant qu'il n'y a aucun avis.</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "BN · Real reviews",
  "settings": [
    { "type": "paragraph", "content": "Add only real reviews from real customers, with their permission. The section stays hidden on the live store until at least one review is added." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Elles en parlent" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Leur petit moment à elles" },
    { "type": "text", "id": "heading_ar", "label": "Arabic / Darija line", "default": "شنو قالو البنات" },
    { "type": "select", "id": "style", "label": "Background", "default": "blush", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "blush", "label": "Blush" }, { "value": "white", "label": "White" }
    ] }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "text", "label": "Review text (exact words of the customer)" },
      { "type": "text", "id": "name", "label": "First name or initial" },
      { "type": "text", "id": "city", "label": "City" },
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "image_picker", "id": "image", "label": "Screenshot (names hidden)" }
    ] }
  ],
  "presets": [ { "name": "BN · Real reviews" } ]
}
{% endschema %}
