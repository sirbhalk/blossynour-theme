{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign products = collections.all.products
  else
    assign products = collection.products
  endif
-%}
<section class="bn-section bn-products bn-section--{{ section.settings.style }}">
  <div class="bn-container">
    <div class="bn-center">
      {%- if section.settings.eyebrow != blank -%}<p class="bn-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="bn-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.heading_ar != blank -%}<span class="bn-ar" lang="ar">{{ section.settings.heading_ar }}</span>{%- endif -%}
      <div class="bn-divider"><span></span></div>
    </div>
    {%- if products.size > 0 -%}
      <ul class="bn-grid bn-products__grid" role="list" style="--bn-cols: {{ section.settings.columns }};">
        {%- for product in products limit: section.settings.limit -%}
          {%- assign v = product.selected_or_first_available_variant -%}
          <li class="bn-pcard">
            <a class="bn-pcard__media" href="{{ product.url }}">
              {%- if product.compare_at_price > product.price -%}<span class="bn-pcard__badge">{{ 'bn.sale' | t }}</span>{%- endif -%}
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, (min-width: 481px) 50vw, 100vw', class: 'bn-pcard__img' }}
                {%- if product.media.size > 1 -%}
                  {{ product.media[1] | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', class: 'bn-pcard__img bn-pcard__img--alt' }}
                {%- endif -%}
              {%- else -%}
                {% render 'bn-icon', name: 'arch-rose', class: 'bn-placeholder' %}
              {%- endif -%}
            </a>
            <div class="bn-pcard__body">
              <a class="bn-pcard__title" href="{{ product.url }}">{{ product.title }}</a>
              <p class="bn-pcard__price">
                {{ v.price | money }}
                {%- if v.compare_at_price > v.price -%} <s>{{ v.compare_at_price | money }}</s>{%- endif -%}
              </p>
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ v.id }}">
                <button type="submit" class="bn-btn bn-btn--block" {% unless v.available %}disabled{% endunless %}>
                  {%- if v.available -%}{{ 'bn.add_to_cart' | t }}{%- else -%}{{ 'bn.sold_out' | t }}{%- endif -%}
                </button>
              {%- endform -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="bn-editor-note">Ajoutez vos produits dans Shopify pour remplir cette grille.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BN · Product grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty = all products" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "La boutique" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nos rituels" },
    { "type": "text", "id": "heading_ar", "label": "Arabic / Darija line", "default": "اختاري اللي يناسبك" },
    { "type": "select", "id": "style", "label": "Background", "default": "cream", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "blush", "label": "Blush" }, { "value": "white", "label": "White" }
    ] }
  ],
  "presets": [ { "name": "BN · Product grid" } ]
}
{% endschema %}
