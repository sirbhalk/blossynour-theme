{%- liquid
  assign phone = section.settings.phone | remove: ' ' | remove: '+' | remove: '-'
-%}
<section class="bn-section bn-ty bn-section--cream bn-section--pattern">
  <div class="bn-container--narrow bn-center">
    <div class="bn-ty__badge" aria-hidden="true">{% render 'bn-icon', name: 'check' %}</div>
    {%- if section.settings.eyebrow != blank -%}<p class="bn-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="bn-title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="bn-lead">{{ section.settings.text }}</div>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="bn-ty__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="bn-ty__step{% if forloop.first %} is-done{% endif %}" {{ block.shopify_attributes }}>
            <span class="bn-ty__dot">{% if forloop.first %}{% render 'bn-icon', name: 'check' %}{% else %}{{ forloop.index }}{% endif %}</span>
            <span class="bn-ty__label">
              <strong>{{ block.settings.title }}</strong>
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

<section class="bn-section bn-section--white">
  <div class="bn-container">
    <div class="bn-center">
      {%- if section.settings.tips_heading != blank -%}<h2 class="bn-title">{{ section.settings.tips_heading }}</h2>{%- endif -%}
      <div class="bn-divider"><span></span></div>
    </div>
    <ul class="bn-grid" role="list" style="--bn-cols: 3;">
      <li class="bn-card">
        {% render 'bn-icon', name: 'heart', class: 'bn-card__icon' %}
        <h3>{{ section.settings.tip1_title }}</h3>
        <p>{{ section.settings.tip1_text }}</p>
      </li>
      <li class="bn-card">
        {% render 'bn-icon', name: 'cash', class: 'bn-card__icon' %}
        <h3>{{ section.settings.tip2_title }}</h3>
        <p>{{ section.settings.tip2_text }}</p>
      </li>
      <li class="bn-card">
        {% render 'bn-icon', name: 'box', class: 'bn-card__icon' %}
        <h3>{{ section.settings.tip3_title }}</h3>
        <p>{{ section.settings.tip3_text }}</p>
      </li>
    </ul>
  </div>
</section>

<section class="bn-section bn-section--plum bn-section--pattern">
  <div class="bn-container--narrow bn-center">
    <h2 class="bn-title">{{ section.settings.help_heading }}</h2>
    {%- if section.settings.help_text != blank -%}<div class="bn-lead">{{ section.settings.help_text }}</div>{%- endif -%}
    <div class="bn-cta__row">
      {%- if phone != blank -%}
        <a class="bn-btn bn-btn--light" href="https://wa.me/{{ phone }}?text={{ section.settings.wa_message | url_encode }}" target="_blank" rel="noopener">
          {% render 'bn-icon', name: 'whatsapp', class: 'bn-inline-icon' %}<span>{{ section.settings.wa_label }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="bn-btn bn-btn--ghost" href="{{ section.settings.link_url | default: routes.root_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BN · Thank you",
  "settings": [
    { "type": "header", "content": "Confirmation" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Order received" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thank you, your order is confirmed!" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Your little hammam moment is on its way. We'll contact you very soon to confirm your order.</p>" },
    { "type": "header", "content": "While you wait" },
    { "type": "text", "id": "tips_heading", "label": "Heading", "default": "While you wait" },
    { "type": "text", "id": "tip1_title", "label": "Tip 1 title", "default": "Keep your phone close" },
    { "type": "text", "id": "tip1_text", "label": "Tip 1 text", "default": "We'll call you or message you on WhatsApp to confirm your order before shipping." },
    { "type": "text", "id": "tip2_title", "label": "Tip 2 title", "default": "Prepare the amount" },
    { "type": "text", "id": "tip2_text", "label": "Tip 2 text", "default": "You pay in cash on delivery, after checking your parcel." },
    { "type": "text", "id": "tip3_title", "label": "Tip 3 title", "default": "A discreet parcel" },
    { "type": "text", "id": "tip3_text", "label": "Tip 3 text", "default": "The outer box shows no product name." },
    { "type": "header", "content": "Help" },
    { "type": "text", "id": "help_heading", "label": "Heading", "default": "A question about your order?" },
    { "type": "richtext", "id": "help_text", "label": "Text", "default": "<p>We're here for you on WhatsApp.</p>" },
    { "type": "text", "id": "phone", "label": "WhatsApp number" },
    { "type": "text", "id": "wa_label", "label": "WhatsApp button", "default": "Write to us on WhatsApp" },
    { "type": "text", "id": "wa_message", "label": "WhatsApp message", "default": "Hello, I just placed an order on Blossy Nour" },
    { "type": "text", "id": "link_label", "label": "Second button", "default": "Back to the shop" },
    { "type": "url", "id": "link_url", "label": "Second button link" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "limit": 5, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "BN · Thank you" } ]
}
{% endschema %}
